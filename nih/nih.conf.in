# -*-mode: sh-*-

# For detailed list of settings see @dfltconfdir@/nih.default.conf
# which is loaded before @sysconfdir@/nih/config.

# Comment in the following in order to disable IPv6 while downloading
#FTP_OPTIONS='-4'
#WGET_OPTIONS='-4'

rep=$(pkg_admin config-var PKG_PATH | sed 's,/All,,')
if test -n "$rep"; then
    REPOSITORY="$rep"
    unset rep
fi

# If you don't like the default REPOSITORY, modify the following lines.
#REPOSITORY="https://cdn.netbsd.org/pub/pkgsrc/packages/$opsys/$(uname -p)/$osver"
